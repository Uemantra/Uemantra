[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1"]
[ext_resource type="Script" path="res://scripts/style/audio_integrator.gd" id="2"]

[node name="Main" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -80.0
offset_right = 150.0
offset_bottom = 80.0
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="VBox"]
text = "Last Light Archive"

[node name="NewGame" type="Button" parent="VBox"]
text = "New Game"

[node name="Continue" type="Button" parent="VBox"]
text = "Continue"

[node name="AudioIntegrator" type="Node" parent="."]
script = ExtResource("2")

[connection signal="pressed" from="VBox/NewGame" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="VBox/Continue" to="." method="_on_continue_pressed"]
